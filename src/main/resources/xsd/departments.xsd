<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://example.com/employeeapi/ws"
           xmlns:tns="http://example.com/employeeapi/ws"
           elementFormDefault="qualified">

    <xs:complexType name="DepartmentType">
        <xs:sequence>
            <xs:element name="id" type="xs:long" minOccurs="0"/>
            <xs:element name="departmentName" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="GetDepartmentByIdRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="GetDepartmentByIdResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="department" type="tns:DepartmentType" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CreateDepartmentRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="department" type="tns:DepartmentType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CreateDepartmentResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="department" type="tns:DepartmentType" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="PatchDepartmentRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
                <xs:element name="department" type="tns:DepartmentType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="PatchDepartmentResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="department" type="tns:DepartmentType" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteDepartmentRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="DeleteDepartmentResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
